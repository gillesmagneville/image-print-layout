#
# Scripts read by bash must keep Unix line endings, even in a Windows working
# copy (MSYS2): a carriage return would break their execution.
*.sh   text eol=lf
*.1    text eol=lf
VERSION  text eol=lf
postinst text eol=lf
postrm   text eol=lf
*.ico  binary
*.png  binary
